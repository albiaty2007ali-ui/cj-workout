# ============================================
# CJ FOOD (Flask) — انسخ هذا الملف إلى .env
# لا ترفع .env إلى GitHub أبدًا
# ============================================

# مفتاح سري لتشفير الجلسات وتوقيع روابط إعادة تعيين كلمة المرور
# ولّد واحد عشوائي حقيقي بالأمر: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

# قاعدة البيانات — SQLite افتراضيًا (ملف محلي داخل مجلد instance/)، تقدر تبدلها لاحقًا بـ PostgreSQL
DATABASE_URL=sqlite:///cjworkout.db

# --- الدفع اليدوي ---
MANUAL_PAYMENT_CARD_NUMBER=CHANGE_ME_TO_YOUR_CARD_NUMBER
MANUAL_PAYMENT_CARD_NETWORK=Mastercard
SUBSCRIPTION_PRICE_IQD=10000
SUPPORT_WHATSAPP_NUMBER=CHANGE_ME_TO_YOUR_WHATSAPP_NUMBER

# --- البريد الإلكتروني (Resend) ---
RESEND_API_KEY=CHANGE_ME_TO_YOUR_RESEND_API_KEY
EMAIL_FROM=CJ FOOD <onboarding@resend.dev>
# ملاحظة: onboarding@resend.dev يرسل فقط لإيميلك المسجل بحساب Resend
# حتى توثّق دومين حقيقي من Resend Dashboard > Domains

# --- إشعارات Web Push (النسخة الجديدة Netlify/Firebase) ---
# ولّد زوج مفاتيح حقيقي بالأمر: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_CLAIMS_EMAIL=mailto:you@example.com

# --- تسجيل الدخول عبر Google (اختياري، النسخة الجديدة Netlify/Firebase) ---
# Web OAuth Client ID من Google Cloud Console (APIs & Services > Credentials > Create OAuth
# client ID > Web application). نفس القيمة تُستخدم بالفرونت إند (VITE_GOOGLE_CLIENT_ID، أسفل)
# وبالباك اند (للتحقق من التوقيع) — بدونها، زر "الدخول بـGoogle" غير مفعّل بأمان (503).
GOOGLE_CLIENT_ID=CHANGE_ME_TO_YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=CHANGE_ME_TO_YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID

# --- الأدمن (النسخة الجديدة Netlify/Firebase) ---
# ADMIN_EMAIL القديم يبقى للتوافق الخلفي، لكن isAdminClaims يقرأ ADMIN_EMAILS أولاً لو مضبوطة —
# قائمة بريد مفصولة بفواصل، تدعم أكثر من حساب إدارة
ADMIN_EMAIL=CHANGE_ME_TO_YOUR_ADMIN_EMAIL
ADMIN_EMAILS=CHANGE_ME_TO_YOUR_ADMIN_EMAIL,CHANGE_ME_TO_SECOND_ADMIN_EMAIL

# --- صياغة ردود الشات عبر AI (اختياري، النسخة الجديدة Netlify/Firebase) ---
# مفتاح مجاني من Google AI Studio: https://aistudio.google.com/app/apikey
# بدون AI_PROVIDER=gemini + GEMINI_API_KEY، الشات يشتغل بالقوالب الجاهزة فقط (سلوك افتراضي آمن)
AI_PROVIDER=CHANGE_ME_TO_gemini_TO_ENABLE
GEMINI_API_KEY=CHANGE_ME_TO_YOUR_GEMINI_API_KEY

# --- Gemini كـ"دماغ" محادثة كامل (النسخة الجديدة Netlify/Firebase فقط — راجع AI_ARCHITECTURE.md) ---
# يحتاج GEMINI_API_KEY أعلاه (بدونه يبقى OFF فعليًا حتى لو ضبطت القيمة هنا — GeminiConversation
# Provider يسقط تلقائيًا لمزوّد فارغ). ثلاث قيم فقط:
#   OFF (افتراضي، أي قيمة غير معروفة تُعامَل كـOFF) — صفر لمسة، السلوك المحلي القديم كما هو تمامًا.
#   SHADOW — Gemini يشتغل بالخلفية ويُسجَّل بـ[conversation] logs للمقارنة، لكن الرد الفعلي
#            للمستخدم دائمًا من المسار المحلي، وأي تحوّر (تسجيل وجبة/ماي) يُحاكى فقط (صفر كتابة حقيقية).
#   ACTIVE — Gemini يستلم كل رسالة ويرد بلهجة عراقية طبيعية، يستخدم الأدوات (Tools) للحسابات/
#            البيانات الحقيقية فقط (صفر أرقام مخترعة — الحقول العددية دايمًا من نتيجة الأداة، Gemini
#            يتحكم بنص الرد فقط). تسجيل وجبة/ماي يبقى محكوم بنفس البوابة المحلية الحتمية
#            (isConsumptionAuthorized/isWaterLogAuthorized بـintents.ts) بغض النظر عمّا يدّعيه Gemini.
GEMINI_CONVERSATIONAL_MODE=OFF
# الموديل المستخدم لكل من طبقة NLU وطبقة المحادثة أعلاه — اتركه فاضي لاستخدام الافتراضي
# (gemini-3.5-flash-lite حاليًا).
GEMINI_MODEL=

# --- إعلانات (اختياري، النسخة الجديدة Netlify/Firebase) ---
# أكواد Adsterra الخام (Script/HTML كامل من لوحة Adsterra) — تُقرأ وقت بناء الفرونت إند (Vite)،
# لازم بادئة VITE_ حتى تنضم للحزمة الثابتة. بدون قيمة = ماكو إعلان يظهر بذاك المكان (آمن تمامًا).
VITE_AD_RECIPES_TOP=
VITE_AD_DAILY_BOTTOM=
VITE_AD_WEIGHT_BOTTOM=
VITE_AD_SUBSCRIBE_INTERSTITIAL=

# --- بيئة التشغيل ---
FLASK_ENV=development
# خله True فقط بعد نشر الموقع على HTTPS حقيقي
SESSION_COOKIE_SECURE=False

# --- إشعارات Web Push (اختياري) ---
# ولّد زوج مفاتيح حقيقي مرة وحدة بالأمر: python3 scripts/generate_vapid_keys.py
# بدون هذي المفاتيح، نظام الإشعارات يبقى معطّل بأمان (ما يرمي خطأ) — بس ما يقدر يرسل Push فعلي
VAPID_PUBLIC_KEY=CHANGE_ME_RUN_scripts/generate_vapid_keys.py
VAPID_PRIVATE_KEY_PEM_BASE64=CHANGE_ME_RUN_scripts/generate_vapid_keys.py
VAPID_CLAIMS_EMAIL=mailto:you@example.com
# يشغّل/يوقف Scheduler الإشعارات الدوري — خله False بالاختبارات/CI
NOTIFICATION_SCHEDULER_ENABLED=True
