# ============================================
# CJ WORKOUT (Flask) — انسخ هذا الملف إلى .env
# لا ترفع .env إلى GitHub أبدًا
# ============================================

# مفتاح سري لتشفير الجلسات وتوقيع روابط إعادة تعيين كلمة المرور
# ولّد واحد عشوائي حقيقي بالأمر: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

# قاعدة البيانات — SQLite افتراضيًا (ملف محلي داخل مجلد instance/)، تقدر تبدلها لاحقًا بـ PostgreSQL
DATABASE_URL=sqlite:///cjworkout.db

# --- الدفع اليدوي ---
MANUAL_PAYMENT_CARD_NUMBER=CHANGE_ME_TO_YOUR_CARD_NUMBER
MANUAL_PAYMENT_CARD_NETWORK=Mastercard
SUBSCRIPTION_PRICE_IQD=10000
SUPPORT_WHATSAPP_NUMBER=CHANGE_ME_TO_YOUR_WHATSAPP_NUMBER

# --- البريد الإلكتروني (Resend) ---
RESEND_API_KEY=CHANGE_ME_TO_YOUR_RESEND_API_KEY
EMAIL_FROM=CJ WORKOUT <onboarding@resend.dev>
# ملاحظة: onboarding@resend.dev يرسل فقط لإيميلك المسجل بحساب Resend
# حتى توثّق دومين حقيقي من Resend Dashboard > Domains

# --- بيئة التشغيل ---
FLASK_ENV=development
# خله True فقط بعد نشر الموقع على HTTPS حقيقي
SESSION_COOKIE_SECURE=False

# --- إشعارات Web Push (اختياري) ---
# ولّد زوج مفاتيح حقيقي مرة وحدة بالأمر: python3 scripts/generate_vapid_keys.py
# بدون هذي المفاتيح، نظام الإشعارات يبقى معطّل بأمان (ما يرمي خطأ) — بس ما يقدر يرسل Push فعلي
VAPID_PUBLIC_KEY=CHANGE_ME_RUN_scripts/generate_vapid_keys.py
VAPID_PRIVATE_KEY_PEM_BASE64=CHANGE_ME_RUN_scripts/generate_vapid_keys.py
VAPID_CLAIMS_EMAIL=mailto:you@example.com
# يشغّل/يوقف Scheduler الإشعارات الدوري — خله False بالاختبارات/CI
NOTIFICATION_SCHEDULER_ENABLED=True
